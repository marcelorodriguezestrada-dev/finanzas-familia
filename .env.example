# ── Firebase — Auth + Firestore (plan gratuito Spark alcanza sobra) ──
# Sacás estos datos creando un proyecto en https://console.firebase.google.com
# 1. Creá el proyecto, activá Authentication → Email/Password
# 2. Activá Firestore Database (modo producción)
# 3. Configuración del proyecto → Tus apps → Web → copiás esto:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (SDK de servidor) ──
# Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
# Eso descarga un JSON; de ahí sacás estos tres valores.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# OJO: pegá el valor de "private_key" tal cual viene en el JSON, entre
# comillas dobles, con los \n literales adentro (no los reemplaces vos
# a mano — el código ya se encarga de convertirlos).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
