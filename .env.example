# ── Firebase — Auth + Firestore (plan gratuito Spark alcanza sobra) ──
# Sacás estos datos creando un proyecto en https://console.firebase.google.com
# 1. Creá el proyecto, activá Authentication → Email/Password
# 2. Activá Firestore Database (modo producción)
# 3. Configuración del proyecto → Tus apps → Web → copiás esto:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (SDK de servidor) ──
# Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
# Eso descarga un JSON; de ahí sacás estos tres valores.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# OJO: pegá el valor de "private_key" tal cual viene en el JSON, entre
# comillas dobles, con los \n literales adentro (no los reemplaces vos
# a mano — el código ya se encarga de convertirlos).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── ImgBB — para guardar contratos escaneados y comprobantes de gastos ──
# 1. Entrá a https://imgbb.com/ con tu cuenta (marcelo-tony-rod)
# 2. Andá a https://api.imgbb.com/ y tocá "Get API key" (te la genera
#    al toque, es gratis, no es la URL de tu galería)
# 3. Pegás esa key acá:
IMGBB_API_KEY=

# ── Supabase Storage — para PDFs de verdad (ImgBB solo acepta imágenes) ──
# 1. Entrá a https://supabase.com/dashboard y creá un proyecto (gratis)
# 2. Storage (menú izquierdo) → "New bucket" → nombre "contratos" →
#    marcalo como Public bucket
# 3. Project Settings → API: copiá acá abajo la "Project URL" y la
#    "service_role" key — OJO: la "service_role", NUNCA la "anon"/public
#    para esto. La service_role tiene permiso de escribir en el storage
#    sin necesitar políticas de seguridad configuradas; si se expusiera
#    en el navegador, cualquiera podría leer/escribir todo tu proyecto.
#    Por eso solo se usa del lado del servidor (ver /api/subir-pdf).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
